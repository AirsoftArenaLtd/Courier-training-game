+  const room = SAVE.SCORM12_LIMIT - JSON.stringify(stored()).length;
+  // 324 when written (B-68): richer stops (C-33) add about 60 for five stops of intercoms, receptions, lockers and reattempts
+  assert.ok(room >= 300, `room left under the ${SAVE.SCORM12_LIMIT}-character limit with C-34's damage too: ${room}`);
+  reload(); W.resume(null);
+  assert.equal(W.log.score(), live.score, 'the reloaded score is the same');
+  assert.equal(OTR.drive.pins(W.log).length, pinsLive, 'every damage, strike and shift keeps its pin');
+  const marks = OTR.drive.pins(W.log).map(p => p.mark).filter(Boolean);
+  ['damage', 'clearance', 'load'].forEach(m => assert.ok(marks.includes(m), m + ' has its own pin shape'));
+});
+
 test('B-55: a packed day writes type names short and stop checks in pairs, and comes back the same; an older packed day still loads', () => {
   const evs = milestone8Day().map(([type, d]) => Object.assign({ type, key: null, ok: true, stop: null }, d || {}, { ok: !(d && d.ok === false) }));
   const packed = SAVE.packDay({ id: 'w', day: 4, events: evs });
diff --git a/test/tools/review-branch.js b/test/tools/review-branch.js
new file mode 100644
index 0000000..dadc742
--- /dev/null
+++ b/test/tools/review-branch.js
@@ -0,0 +1,101 @@
+#!/usr/bin/env node
+/*
+ * B-69: the same first steps for every review of a Codex branch. Merges the branch into the current origin/pilot in a
+ * scratch worktree (never touching yours), then runs every Node suite (test/run-all.js), lists the text that still needs
+ * translating (in any of the 11 languages, after data/i18n/not-text.json), and plays the five workday flows at Low.
+ * Prints one summary; the merge commit stays in the worktree for the reviewer to translate, fix and push.
+ *
+ *   node test/tools/review-branch.js codex/c34-damage-load        (or: node test/run-all.js --review <branch>)
+ *   --no-flows   skip the workday flows (about 25 minutes)
+ *   --continue   after resolving a conflicted merge in the worktree and committing it: run the checks there again
+ * The worktree is ../otr-review-<branch name> next to the repository, and the missing text goes to
+ * test/out/review-<name>/missing.json there (the shape the translation helpers take: { strings, templates }).
+ */
+'use strict';
+const fs = require('fs');
+const path = require('path');
+const cp = require('child_process');
+
+const ROOT = path.resolve(__dirname, '..', '..');
+const args = process.argv.slice(2);
+const branch = args.find(a => !a.startsWith('--'));
+if (!branch) { console.error('usage: node test/tools/review-branch.js <branch> [--no-flows] [--keep]'); process.exit(2); }
+const name = branch.replace(/^origin\//, '').replace(/[^\w.-]+/g, '-');
+const WT = path.resolve(ROOT, '..', `otr-review-${name}`);
+const git = (a, o) => cp.execFileSync('git', a, Object.assign({ cwd: ROOT, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }, o || {}));
+const steps = [];
+const step = (what, ok, detail) => { steps.push({ what, ok, detail }); console.log(`${ok ? 'ok  ' : 'FAIL'} ${what}${detail ? ': ' + detail : ''}`); };
+
+// what test/i18n.js treats as an id rather than text (kept the same as its own rule)
+const idlike = (s) => /^#[0-9A-Fa-f]{3,8}$/.test(s) || /^[a-z0-9_]+([.:_-][a-z0-9_]*)*[:.?]?$/.test(s) || /^\[|^\(debug/.test(s) || /^\|otr-[a-z0-9-]+$/.test(s);
+
+/** Text in the catalogue that some language has no translation for (as test/i18n.js counts it). */
+function missingText(dir) {
+  const cat = JSON.parse(fs.readFileSync(path.join(dir, 'data', 'i18n', 'catalogue.json'), 'utf8'));
+  const notText = new Set(JSON.parse(fs.readFileSync(path.join(dir, 'data', 'i18n', 'not-text.json'), 'utf8')));
+  const strings = new Set(), templates = new Set();
+  for (const lang of ['es', 'fr', 'hi', 'bn', 'mr', 'te', 'ta', 'gu', 'kn', 'ml', 'pa']) {
+    const w = {}; new Function('window', fs.readFileSync(path.join(dir, 'data', 'i18n', lang + '.js'), 'utf8'))(w);
+    const L = w.OTR_I18N[lang], have = new Set(Object.keys(L.strings)), haveT = new Set((L.templates || []).map(t => t[0].trim())), keep = new Set(L.keep || []);
+    cat.strings.forEach(s => { if (!have.has(s) && !have.has(s.trim()) && !keep.has(s) && !notText.has(s) && !idlike(s)) strings.add(s); });
+    cat.templates.forEach(t => { if (!haveT.has(t.trim()) && !idlike(t.replace(/\{\d+\}/g, '0'))) templates.add(t); });
+  }
+  return { strings: [...strings], templates: [...templates] };
+}
+
+const run = (cmd, a, env, log) => {
+  const r = cp.spawnSync(cmd, a, { cwd: WT, env: Object.assign({}, process.env, env || {}), encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 });
+  if (log) fs.writeFileSync(log, (r.stdout || '') + (r.stderr || ''));
+  return r;
+};
+
+(() => {
+  git(['fetch', '-q', 'origin']);
+  const ref = branch.startsWith('origin/') ? branch : 'origin/' + branch;
+  const ahead = git(['rev-list', '--count', `origin/pilot..${ref}`]).trim();
+  console.log(`${ref}: ${ahead} commit(s) not in pilot; worktree ${WT}\n`);
+  const again = args.includes('--continue');
+  if (again) {
+    const open = cp.spawnSync('git', ['diff', '--name-only', '--diff-filter=U'], { cwd: WT, encoding: 'utf8' }).stdout.trim();
+    const merged = cp.spawnSync('git', ['merge-base', '--is-ancestor', ref, 'HEAD'], { cwd: WT }).status === 0;
+    if (!fs.existsSync(WT) || open || !merged) { console.error(`--continue needs ${WT} with the merge resolved and committed`); process.exit(2); }
+  } else {
+    if (fs.existsSync(WT)) { try { git(['worktree', 'remove', '--force', WT]); } catch (e) { fs.rmSync(WT, { recursive: true, force: true }); git(['worktree', 'prune']); } }
+    git(['worktree', 'add', '-q', '--detach', WT, 'origin/pilot']);
+  }
+  const nm = path.join(ROOT, 'test', 'node_modules');
+  if (fs.existsSync(nm) && !fs.existsSync(path.join(WT, 'test', 'node_modules'))) fs.symlinkSync(nm, path.join(WT, 'test', 'node_modules'));
+  const merge = again ? { status: 0 } : cp.spawnSync('git', ['merge', '--no-edit', '-q', ref], { cwd: WT, encoding: 'utf8' });
+  if (merge.status !== 0) {
+    const conflicts = cp.spawnSync('git', ['diff', '--name-only', '--diff-filter=U'], { cwd: WT, encoding: 'utf8' }).stdout.trim().split('\n').filter(Boolean);
+    step('merge into pilot', false, `${conflicts.length} file(s) in conflict: ${conflicts.join(', ')} (resolve them in the worktree and commit, then run this again with --continue)`);
+    process.exit(1);
+  }
+  step('merge into pilot', true, git(['rev-parse', '--short', 'HEAD'], { cwd: WT }).trim());
+  const OUT = path.join(WT, 'test', 'out', `review-${name}`);
+  fs.mkdirSync(OUT, { recursive: true });
+
+  run(process.execPath, ['test/tools/i18n-extract.js']);
+  const miss = missingText(WT);
+  fs.writeFileSync(path.join(OUT, 'missing.json'), JSON.stringify(miss, null, 1));
+  step('text to translate', !miss.strings.length && !miss.templates.length, `${miss.strings.length} line(s), ${miss.templates.length} template(s)` +
+    (miss.strings.length ? ` → test/out/review-${name}/missing.json (e.g. ${JSON.stringify(miss.strings.slice(0, 3))})` : ''));
+
+  const suites = run(process.execPath, ['test/run-all.js'], {}, path.join(OUT, 'run-all.log'));
+  const last = (suites.stdout || '').trim().split('\n').pop();
+  step('every Node suite', suites.status === 0, last + (suites.status ? ` (logs: test/out/run-all/ in the worktree)` : ''));
+
+  if (!args.includes('--no-flows')) {
+    const flows = run(process.execPath, ['test/qa.js', '--only', 'workday-3d,workday-3d-b,workday-3d-c,workday-aids,drive-review'],
+      { QA_GFX: 'low', QA_FPS_FLOOR: '8', QA_PORT: String(8400 + Math.floor(Math.random() * 90)),
+        QA_BROWSER: process.env.QA_BROWSER || ['/opt/pw-browsers/chromium', '/usr/bin/chromium'].find(p => fs.existsSync(p)) || '' }, path.join(OUT, 'flows.log'));
+    const clean = /(\d+)\/(\d+) scenarios clean/.exec(flows.stdout || '');
+    step('the five workday flows at Low', flows.status === 0, clean ? clean[0] : 'see flows.log');
+  }
+
+  const bad = steps.filter(s => !s.ok);
+  console.log(`\n${steps.length - bad.length} of ${steps.length} review steps passed for ${ref}.` +
+    (bad.length ? ` Next: ${bad.map(s => s.what).join(', ')}. The merge is in ${WT}.` : ` Translate, update the board, then push from ${WT}.`));
+  if (!bad.length) console.log('(the worktree stays for the board and the push: give it a branch with git switch -c, and remove it afterwards with git worktree remove ' + WT + ')');
+  process.exit(bad.length ? 1 : 0);
+})();
diff --git a/test/trainerkeysbrowser.js b/test/trainerkeysbrowser.js
new file mode 100644
index 0000000..76b2423
--- /dev/null
+++ b/test/trainerkeysbrowser.js
@@ -0,0 +1,89 @@
+#!/usr/bin/env node
+/*
+ * B-62: the trainer's dialogs from the keyboard alone. On the trainer screen, Tab reaches "3D workday aids…" and Enter
+ * opens it; in the dialog Tab reaches every choice and Done, Enter picks one, and Escape closes it. New account takes
+ * the employee ID and then the name from the keyboard; Escape leaves it. The temporary-password card closes with Enter
+ * and with Escape. No mouse is used. The page is told it is on a training server with accounts (no server is needed:
+ * the trainee list just fails to load).
+ *
+ *   QA_BROWSER=/path/to/chrome node test/trainerkeysbrowser.js         (QA_LANG=ta to run it in another language)
+ */
+'use strict';
+const path = require('path');
+const pp = require('puppeteer-core');
+const BROWSER = process.env.QA_BROWSER || '/opt/pw-browsers/chromium';
+const LANG = process.env.QA_LANG || '';
+const URL = 'file://' + path.resolve(__dirname, '..', 'index.html') + '?user=keys&name=Sam%20Lee' + (LANG ? `&lang=${LANG}&dev=1` : '');
+const wait = (ms) => new Promise(r => setTimeout(r, ms));
+let checks = 0;
+const fails = [];
+const check = (ok, what) => { checks++; console.log(`${ok ? 'ok  ' : 'FAIL'} ${what}`); if (!ok) fails.push(what); };
+
+(async () => {
+  const b = await pp.launch({ executablePath: BROWSER, headless: 'new', args: ['--no-sandbox', '--allow-file-access-from-files', '--use-gl=swiftshader', '--enable-unsafe-swiftshader'] });
+  const errors = [];
+  try {
+    const p = await b.newPage();
+    await p.setViewport({ width: 1280, height: 720 });
+    p.on('pageerror', e => errors.push(e.message));
+    const ev = (f, ...a) => p.evaluate(f, ...a);
+    const until = async (src, ms) => { const t0 = Date.now(); while (Date.now() - t0 < (ms || 15000)) { if (await p.evaluate(src).catch(() => false)) return true; await wait(150); } return false; };
+    const key = async (k, n) => { for (let i = 0; i < (n || 1); i++) { await p.keyboard.press(k); await wait(120); } };
+    // the English of what the focus ring is on (a button's label), or null
+    const ring = () => ev(() => { const s = OTR.game.scene.getScene('TrainerScene'), f = s._focusOn, c = f && f.current && f.current(); return c && c.label ? OTR.i18n.src(c.label) : null; });
+    const modals = () => ev(() => (OTR.game.scene.getScene('TrainerScene')._modalStack || []).filter(m => m.active).length);
+    // Tab until the ring is on a control whose English matches; true if it got there
+    const tabTo = async (re, max) => { for (let i = 0; i < (max || 40); i++) { await key('Tab'); const at = await ring(); if (at && re.test(at)) return true; } return false; };
+    await p.goto(URL);
+    if (!(await until(`OTR.game.scene.isActive('TitleScene')`, 20000))) throw new Error('the title never opened');
+    const trainer = async () => {
+      await ev(() => { OTR.identity.mode = 'server'; OTR.identity.accounts = true; const m = OTR.game.scene; m.getScenes(true).forEach(s => m.stop(s.sys.settings.key)); m.start('TrainerScene', {}); });
+      if (!(await until(`OTR.game.scene.isActive('TrainerScene')`, 15000))) throw new Error('the trainer screen never opened');
+      await wait(900);
+    };
+    await trainer();
+
+    // 3D workday aids: open, every control reachable, pick "Off" for the sat nav, Done, then Escape on a second opening
+    check(await tabTo(/^3D workday aids/), 'Tab reaches "3D workday aids…" on the trainer screen');
+    await key('Enter'); await wait(500);
+    check(await modals() === 1, 'Enter opens the aids dialog');
+    const seen = new Set();
+    for (let i = 0; i < 20; i++) { await key('Tab'); const at = await ring(); if (at) seen.add(at + '#' + i); }
+    const labels = new Set([...seen].map(x => x.split('#')[0]));
+    ['Fade by day', 'Full', 'Light', 'Off', 'Turn by turn', 'Route line', 'Optional', 'Required', 'On', 'Done'].forEach(l => check(labels.has(l), `Tab reaches "${l}" in the aids dialog`));
+    // the sat nav's "Off" is the 8th control in reading order (four assists, then Fade by day, Turn by turn, Route line, Off)
+    let picked = false;
+    for (let i = 0; i < 20 && !picked; i++) {
+      await key('Tab');
+      const ok = await ev(() => { const s = OTR.game.scene.getScene('TrainerScene'), c = s._focusOn && s._focusOn.current(); return !!(c && c.key === 'satnav' && c.val === 'off'); });
+      if (ok) { await key('Enter'); picked = true; }
+    }
+    check(picked && await ev(() => OTR.game.scene.getScene('TrainerScene').draft.workday.satnav === 'off'), 'Enter on the sat nav\'s "Off" sets it in the rules being edited');
+    check(await tabTo(/^Done$/) && (await key('Enter'), await wait(500), await modals()) === 0, 'Done closes the dialog from the keyboard');
+    await tabTo(/^3D workday aids/); await key('Enter'); await wait(500);
+    await key('Escape'); await wait(500);
+    check(await modals() === 0, 'Escape closes the aids dialog');
+
+    // New account: employee ID, then the name, all typed; Escape leaves the second step
+    check(await tabTo(/^New account$/), 'Tab reaches "New account"');
+    await key('Enter'); await wait(500);
+    check(await modals() === 1, 'Enter opens the employee ID entry');
+    await p.keyboard.type('e2077'); await key('Enter'); await wait(700);
+    const second = await ev(() => { const st = (OTR.game.scene.getScene('TrainerScene')._modalStack || []).filter(m => m.active); return st.length === 1; });
+    check(second, 'Enter on the ID moves on to the name');
+    await p.keyboard.type('Pat Okafor'); await wait(200);
+    await key('Escape'); await wait(500);
+    check(await modals() === 0, 'Escape leaves the name step without creating anything');
+
+    // the temporary password: Enter closes it; Escape closes it too
+    for (const k of ['Enter', 'Escape']) {
+      await ev(() => OTR.game.scene.getScene('TrainerScene').showTemp({ id: 'e2077', name: 'Pat Okafor', tempPassword: 'cedar-lantern-31' }));
+      await wait(500);
+      await key(k); await wait(500);
+      check(await modals() === 0, `${k} closes the temporary-password card`);
+    }
+    check(!errors.length, 'no page errors ' + errors.slice(0, 2).join(' | '));
+  } finally { await b.close(); }
+  console.log(fails.length ? `\n${fails.length} of ${checks} keyboard checks failed` : `\n${checks} trainer keyboard checks passed`);
+  process.exit(fails.length ? 1 : 0);
+})().catch(e => { console.error(e); process.exit(1); });
